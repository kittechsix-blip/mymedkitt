export const CRITICAL_ACTIONS: CriticalAction[] = [
  { text: "Tacrolimus labels: in patients with signs and symptoms of TMA, consider tacrolimus as a risk factor; concurrent mTOR inhibitors may contribute.", nodeId: "tpe-tma" },
  { text: "Cyclosporine labels: \"Neither the pathogenesis nor the management of this syndrome is clear.\"", nodeId: "tpe-tma" },
  { text: "Editor note: call the transplant team before changing, holding or stopping any immunosuppressant.", nodeId: "tpe-tma" },
];

