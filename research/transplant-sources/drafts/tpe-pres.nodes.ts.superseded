// DRAFT page for tpe-* (Transplant Patient in the ED): PRES and calcineurin inhibitor neurotoxicity in the transplant recipient. Entry node: tpe-pres (summary and citation present). Drug cards for tacrolimus and cyclosporine link to tpe-pres from their Neurotoxicity row.
// Sources: six FDA labels (DailyMed SPL), ISHLT 2023 heart guideline (heart recipients only), AASLD/AST 2024 liver graft-complications guideline (Table 4 only), IATDMCT 2019 (one sentence). NO primary guideline for PRES in transplant recipients exists in the sources read; review papers were not yet available.
// Imports use draft-relative paths; the assembler rewrites them. Module numbers are 0 for the assembler. Detail lives in drafts/tpe-pres-detail.info.ts (InfoPage id tpe-pres-detail).
// Every clinical sentence is SOURCED (cited, grade only where printed) or begins "Editor note:" or "App content:" (a statement about an existing consult, file and line given in the ledger). No immunosuppressant doses.
// "Editor note: call the transplant team ..." appears once in the entry node (body) and once as critical action 4. Ledger: drafts/tpe-pres.ledger.md
import type { DecisionNode } from '../../../src/models/types.js';
import type { CriticalAction } from '../../../src/services/tree-service.js';

type Citation = { num: number; text: string };

export const CRITICAL_ACTIONS: CriticalAction[] = [
  { text: "Tacrolimus labels: monitor for neurologic symptoms; consider dosage reduction or discontinuation if neurotoxicity occurs.", nodeId: "tpe-pres" },
  { text: "Heart recipients with PRES (ISHLT, Class I, C): gradual blood pressure reduction and CNI withdrawal or reduction, with an alternate agent substituted.", nodeId: "tpe-pres" },
  { text: "Heart recipients (ISHLT narrative): with epilepsy or needing antiepileptic drugs, in general avoid phenytoin, phenobarbital, carbamazepine, valproic acid; fosphenytoin with caution.", nodeId: "tpe-pres-seizure" },
  { text: "Editor note: call the transplant team before changing, holding or stopping any immunosuppressant.", nodeId: "tpe-pres" },
];

