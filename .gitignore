# Dependencies
node_modules/

# Build output
build/
dist/

# Keep .deploy-state/snapshots/ tracked (rollback source for supabase-push.mjs).
.deploy-state/electrobun-build/

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Claudex/codex autonomous loop runtime files
# (collision surface for parallel git ops — see feedback_parallel_session_git_safety)
.claude/claudex/
.playwright-cli/
.playwright-mcp/

# Environment — NEVER commit secrets
.env
.env.*
!.env.example

# Browser profile (Playwright persistent login sessions)
.browser-profile/

# Generated Supabase SQL (regenerated from source via generate-supabase-sql.mjs)
supabase-*-insert.sql

# claudex writes loop state into whatever directory it is invoked from; a copy
# landed in src/data/trees/ and made the skill build-gate see the trees dir as
# dirty on every run. Tool artifact, not clinical source.
src/data/trees/.claude/
**/.claude/claudex/

# Draft visual-review output (image drafts for Andy to approve). Lives under
# docs/ so it can be opened next to the app, but must never ship to Pages.
docs/visual-review/

# Agent worktrees (separate branches checked out by build agents)
.claude/worktrees/
